{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nanbei-admin",
  // 固定部署到 Cloudflare 账户 Sanchai，防止误部署到其他账户（定时任务只能在一个账户中运行）
  "account_id": "a659b71fbdcc5e9023f24bd247b76933",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "photodesk.win", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "WECHAT_APP_ID": "wx7f54ff074d26489f",
    "CLOUDBASE_ENV_ID": "cloud1-d4gbua7848fbcecf0",
    "WECHAT_API_BASE": "https://api.weixin.qq.com",
    "ALLOWED_API_HOSTS": "api.weixin.qq.com",
    "ADMIN_EMAIL": "sanchai20@163.com",
    "EMAIL_FROM": "no-reply@auth.photodesk.win",
    "APP_ORIGIN": "https://photodesk.win"
  },
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "nanbei-admin-auth",
    // Sanchai 账户中的数据库（APAC）。旧账户的 537a6497-… 已于 2026-10-26 迁移后删除。
    "database_id": "460fea35-3925-4656-8cc9-72690a4c0dbc",
    "migrations_dir": "migrations"
  }],
  // 每 30 分钟清理回收列表中到期且无引用的云存储文件（见 worker/index.ts 的 purgeTrash）
  // 注意：purgeTrash 会真实删除云开发存储中的文件。此定时任务只能在一个 Cloudflare 账户中运行
  // （目前为 Sanchai）；切勿把本 Worker 部署到其他账户，否则两处会同时清理同一批文件。
  "triggers": { "crons": ["*/30 * * * *"] },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@auth.photodesk.win"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
  // Secrets 通过控制台或 wrangler secret put 设置，不写入仓库：
  // WECHAT_APP_SECRET：小程序 AppSecret（部署者自行配置）
  // AUTH_SECRET：至少 32 字符的随机验证码 HMAC 密钥
}
